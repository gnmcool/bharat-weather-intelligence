# Copy to backend/.env and adjust. All settings: backend/app/config.py (prefix BWI_)
# BWI_OPENMETEO_API_KEY=            # commercial Open-Meteo key (free tier = non-commercial, 10k calls/day)
# BWI_DATABASE_URL=postgresql://bwi:bwi@localhost:5432/bwi
# BWI_GRID_STORE_MAX_AGE_H=30       # older Earth2Studio stores fall back to the coarse grid
# BWI_CLIMATOLOGY_START_YEAR=1991
# BWI_CLIMATOLOGY_END_YEAR=2020
# BWI_CORS_ORIGINS=["http://localhost:5173"]
